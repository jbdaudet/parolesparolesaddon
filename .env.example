# Variables du module Débat (en dev container : à mettre dans ~/secrets/local-secrets.env sur l'hôte).
GEMINI_API_KEY=
# Recommandé dès qu'il est déployé : sans jeton, tout visiteur peut lancer une analyse payante.
DEBATE_ADMIN_TOKEN=
# Facultatif — valeurs par défaut dans server/debate/config.ts
# DEBATE_VIDEO_MODEL=gemini-3.8-flash
# DEBATE_TEXT_MODEL=gemini-3.8-flash
# DEBATE_EVALUATION_MODEL=gemini-3.8-flash
# Recherche Google pour l'évaluation : auto (défaut, s'en passe si refusée pour quota), on, off.
# Les clés gratuites n'y ont pas accès : activer la facturation du projet Google pour obtenir des sources.
# DEBATE_EVALUATION_SEARCH=auto
# DEBATE_CHUNK_SECONDS=600
# DEBATE_TRANSCRIBE_FPS=0.2
# DEBATE_SURVEY_FPS=0.05
# DEBATE_CONCURRENCY=3
# DEBATE_MAX_DURATION_SEC=14400
# DEBATE_DATA_DIR=data/debates
