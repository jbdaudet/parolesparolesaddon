{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip list)",
      "Bash(pip show:*)",
      "Bash(pip install:*)",
      "Bash(pytest:*)",
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./local-secrets.env)",
      "Read(**/local-secrets.env)"
    ]
  }
}
